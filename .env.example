# Copy to .env and fill in. NEVER commit .env or share these keys.
# .env always wins over Windows/system environment variables of the same name.

# --- Gnani speech (STT + TTS) ---
GNANI_API_KEY=
GNANI_STT_ENDPOINT=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_ENDPOINT=wss://api.vachana.ai/api/v1/tts

# --- AI brain via OpenRouter (OpenAI-compatible) ---
# The variable keeps its OPENAI_ name because LUFY uses the OpenAI-compatible client,
# but it must contain an OPENROUTER key (sk-or-v1-..., create at https://openrouter.ai/keys).
# An OpenAI key (sk-proj-...) will NOT work with OpenRouter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenRouter model IDs use provider/model format:
OPENAI_MODEL=openai/gpt-4o-mini

# Go back to direct OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1  and  OPENAI_MODEL=gpt-4o-mini
# Local server (Ollama):     OPENAI_BASE_URL=http://localhost:11434/v1  (key not needed)

# Optional Anthropic provider
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
